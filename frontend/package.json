{
  "name": "peloton-cards",
  "version": "0.0.0",
  "private": true,
  "description": "Lovelace cards for the Peloton integration for Home Assistant.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome ci --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --minify --legal-comments=eof --charset=utf8 \"--define:__PELOTON_CARDS_VERSION__=\\\"${PELOTON_CARDS_VERSION:-dev}\\\"\" --outfile=../custom_components/peloton/dist/peloton-cards.js"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": false
  }
}
