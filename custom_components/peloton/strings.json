  "options": {
    "step": {
      "init": {
        "description": "How often to check Peloton. Between workouts each check is one request; a shorter interval detects the start of a workout sooner.",
        "data": {
          "idle_interval": "Interval between workouts (seconds)",
          "active_interval": "Interval during a workout (seconds)",
          "max_workout_minutes": "Longest workout without a class length (minutes)"
        },
        "data_description": {
          "idle_interval": "How long it can take to notice that a workout started.",
          "active_interval": "How often live values such as cadence and heart rate update during a workout.",
          "max_workout_minutes": "A workout without a class length (for example Just Ride) that is still marked in progress after this long is treated as ended. Class workouts end 15 minutes after the class length."
        }
