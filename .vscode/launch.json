{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant (scripts/develop)",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": ["--config", "${workspaceFolder}/config", "--debug"],
      "preLaunchTask": "Prepare dev config",
      "justMyCode": false
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "justMyCode": false
    }
  ]
}
